rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/state/{docId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId && docId == 'atelier';
      }
      function validState() {
        return request.resource.data.keys().hasOnly(['saved','completed','notes','answers','updatedAt'])
          && request.resource.data.keys().hasAll(['saved','completed','notes','answers','updatedAt'])
          && request.resource.data.saved is list
          && request.resource.data.saved.size() <= 3
          && request.resource.data.saved.hasOnly(['introducao-a-psicanalise','formacao-freudiana','fundamentos-da-psicanalise'])
          && request.resource.data.completed is list
          && request.resource.data.completed.size() <= 5
          && request.resource.data.completed.hasOnly(['escuta','pergunta-freud','conflito-exemplo','escuta-que-mudou-a-clinica','primeira-topica-freud'])
          && request.resource.data.notes is map
          && request.resource.data.notes.keys().hasOnly(['escuta','pergunta-freud','conflito-exemplo','escuta-que-mudou-a-clinica','primeira-topica-freud'])
          && request.resource.data.notes.get('escuta','') is string
          && request.resource.data.notes.get('pergunta-freud','') is string
          && request.resource.data.notes.get('conflito-exemplo','') is string
          && request.resource.data.notes.get('escuta-que-mudou-a-clinica','') is string
          && request.resource.data.notes.get('primeira-topica-freud','') is string
          && request.resource.data.notes.get('escuta','').size() <= 5000
          && request.resource.data.notes.get('pergunta-freud','').size() <= 5000
          && request.resource.data.notes.get('conflito-exemplo','').size() <= 5000
          && request.resource.data.notes.get('escuta-que-mudou-a-clinica','').size() <= 5000
          && request.resource.data.notes.get('primeira-topica-freud','').size() <= 5000
          && request.resource.data.answers is map
          && request.resource.data.answers.keys().hasOnly(['escuta','pergunta-freud','conflito-exemplo'])
          && request.resource.data.answers.size() <= 3
          && (!('escuta' in request.resource.data.answers) || (request.resource.data.answers.escuta is int && request.resource.data.answers.escuta >= 0 && request.resource.data.answers.escuta <= 2))
          && (!('pergunta-freud' in request.resource.data.answers) || (request.resource.data.answers['pergunta-freud'] is int && request.resource.data.answers['pergunta-freud'] >= 0 && request.resource.data.answers['pergunta-freud'] <= 2))
          && (!('conflito-exemplo' in request.resource.data.answers) || (request.resource.data.answers['conflito-exemplo'] is int && request.resource.data.answers['conflito-exemplo'] >= 0 && request.resource.data.answers['conflito-exemplo'] <= 2))
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0;
      }
      allow read: if isOwner();
      allow create, update: if isOwner() && validState();
      allow delete: if false;
    }

    // Microetapas das duas aulas. Não há fallback para dados de outro UID.
    // No cliente, a conclusão é formativa, não constitui certificação.
    match /users/{userId}/lessonProgress/{lessonId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function knownLesson() {
        return lessonId in ['escuta-que-mudou-a-clinica','primeira-topica-freud'];
      }
      function validEscuta(p) {
        return p.keys().hasOnly([
          'unlocked','done','spots','files','times','concepts','choices','passed',
          'reflection','videoWatched','resumeUnlock','roomCompletedEarly'
        ])
        && p.keys().hasAll(['unlocked','done','spots','files','times','concepts','choices','passed','reflection'])
        && p.unlocked is int && p.unlocked >= 1 && p.unlocked <= 6
        && p.done is list && p.done.size() <= 6 && p.done.hasOnly([1,2,3,4,5,6])
        && p.spots is list && p.spots.size() <= 3 && p.spots.hasOnly([0,1,2])
        && p.files is list && p.files.size() <= 3 && p.files.hasOnly([0,1,2])
        && p.times is list && p.times.size() <= 4 && p.times.hasOnly([0,1,2,3])
        && p.concepts is list && p.concepts.size() <= 4 && p.concepts.hasOnly([0,1,2,3])
        && p.choices is map && p.choices.size() <= 3
        && p.choices.keys().hasOnly(['3','5','6'])
        && p.passed is list && p.passed.size() <= 3 && p.passed.hasOnly([3,5,6])
        && p.reflection is string && p.reflection.size() <= 5000
        && p.get('videoWatched',false) is bool
        && p.get('roomCompletedEarly',false) is bool
        && p.get('resumeUnlock',2) is int;
      }
      function validTopica(p) {
        return p.keys().hasOnly(['passed','visited','videoFinished','thirdAudioDone','wordsCompleted'])
        && p.keys().hasAll(['passed','visited','videoFinished','thirdAudioDone','wordsCompleted'])
        && p.passed is list && p.passed.size() <= 5
        && p.passed.hasOnly(['q1','q2a','q2b','q3a','q3b'])
        && p.visited is list && p.visited.size() <= 3
        && p.visited.hasOnly(['ics','pcs','cs'])
        && p.videoFinished is bool && p.thirdAudioDone is bool
        && p.wordsCompleted is list && p.wordsCompleted.size() <= 4
        && p.wordsCompleted.hasOnly([1,2,3,4]);
      }
      function validDocument() {
        return request.resource.data.keys().hasOnly(['schemaVersion','state','updatedAt'])
        && request.resource.data.keys().hasAll(['schemaVersion','state','updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0
        && request.resource.data.state is map
        && (
          (lessonId == 'escuta-que-mudou-a-clinica' && validEscuta(request.resource.data.state))
          || (lessonId == 'primeira-topica-freud' && validTopica(request.resource.data.state))
        );
      }
      allow get: if owner() && knownLesson();
      allow list: if false;
      allow create, update: if owner() && knownLesson() && validDocument();
      allow delete: if false;
    }

    // Perfil pessoal do estudante. Só a conta do próprio UID pode
    // ler ou alterar este documento. Não há acesso por lista de usuários.
    match /users/{userId}/profile/{docId} {
      function isProfileOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && docId == 'main';
      }
      function validProfile() {
        return request.resource.data.keys().hasOnly(['preferredName','phone','updatedAt'])
          && request.resource.data.keys().hasAll(['preferredName','phone','updatedAt'])
          && request.resource.data.preferredName is string
          && request.resource.data.preferredName.size() <= 80
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0;
      }
      allow get: if isProfileOwner();
      allow list: if false;
      allow create, update: if isProfileOwner() && validProfile();
      allow delete: if false;
    }
  }
}
