{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier · Catálogo de cursos",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "courses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "catalog"
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "manifest",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string"
          },
          "manifest": {
            "type": "string",
            "pattern": "^\\./.*\\.json$"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "published",
              "archived"
            ]
          },
          "summary": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "maxLength": 8
          },
          "demo": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
