{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier · Aula e blocos v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "courseId",
    "moduleId",
    "slug",
    "revision",
    "status",
    "title",
    "blocks",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "lesson"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "courseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1500,
            "maximum": 2500
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object"
        },
        "settings": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "rich_text"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "paragraphs"
                ],
                "properties": {
                  "paragraphs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "question"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "clinical_vignette"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "required": [
                  "narrative",
                  "reflection"
                ],
                "properties": {
                  "narrative": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reflection": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "required": [
                  "prompt",
                  "options",
                  "correctOptionId",
                  "feedbackCorrect",
                  "feedbackIncorrect"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "text"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "correctOptionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "feedbackCorrect": {
                    "type": "string",
                    "minLength": 1
                  },
                  "feedbackIncorrect": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "references"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "required": [
                  "referenceIds"
                ],
                "properties": {
                  "referenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "concept"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "term",
                  "definition"
                ],
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "example": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "text",
                  "attribution"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "comparison"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "title",
                  "columns",
                  "rows"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caption": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "criterion",
                        "values"
                      ],
                      "properties": {
                        "criterion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "values": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeline"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "title",
                  "events"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "date",
                        "title"
                      ],
                      "properties": {
                        "date": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "src"
                ],
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^\\./"
                  },
                  "alt": {
                    "type": "string"
                  },
                  "decorative": {
                    "type": "boolean"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "credit": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "audio"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "src",
                  "transcript"
                ],
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transcript": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "src",
                  "transcript"
                ],
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transcript": {
                    "type": "string",
                    "minLength": 1
                  },
                  "captions": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interactive_lab"
              },
              "version": {
                "const": 1
              }
            },
            "required": [
              "type",
              "version"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "engineId",
                  "title",
                  "alternative"
                ],
                "properties": {
                  "engineId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alternative": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "choices": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label",
                        "feedback"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "feedback": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
