{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier · Manifesto de curso",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "slug",
    "revision",
    "status",
    "title",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "course"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "position",
          "lessons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "path",
                "position"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^\\./.*\\.json$"
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
